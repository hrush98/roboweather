[Unit]
Description=RoboWeather continuous prediction-snapshot research loop
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=-%h/General/roboweather
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/miniconda3/envs/roboweather/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/roboweather %h/General/roboweather/data/logs
ExecStart=/usr/bin/env bash scripts/run_research.sh loop
Restart=always
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=180
MemoryMax=4G
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/roboweather %h/General/roboweather/data/logs

[Install]
WantedBy=default.target
