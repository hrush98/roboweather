[Unit]
Description=RoboWeather bounded Phase 3 market-tape lifecycle probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=-%h/General/roboweather
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/miniconda3/envs/roboweather/bin:/usr/bin:/bin
RuntimeDirectory=roboweather-market-tape-lifecycle
RuntimeDirectoryPreserve=restart
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/roboweather/market_tape/raw
ExecStart=/usr/bin/env python scripts/run_market_tape.py --catalog %h/.local/state/roboweather/market_tape/catalog.sqlite --raw-dir %h/.local/state/roboweather/market_tape/raw --overall-max-seconds 259200 --deadline-state-file %t/roboweather-market-tape-lifecycle/deadline.json --refresh-seconds 240 --rotation-seconds 300 --telemetry-seconds 30 --queue-size 10000 --max-reconnect-attempts 8 --reconnect-initial-seconds 1 --reconnect-max-seconds 30 --max-receipt-lag-seconds 10 --checkpoint-every 1000
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
RuntimeMaxSec=73h
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/roboweather

[Install]
WantedBy=default.target
