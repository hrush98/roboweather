[Unit]
Description=RoboWeather continuous Phase 3 research market tape
After=network-online.target
Wants=network-online.target
Conflicts=roboweather-market-tape-lifecycle.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=-%h/General/roboweather
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/miniconda3/envs/roboweather/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/roboweather/market_tape/raw
ExecStart=/usr/bin/env python scripts/run_market_tape.py --catalog %h/.local/state/roboweather/market_tape/catalog.sqlite --raw-dir %h/.local/state/roboweather/market_tape/raw --refresh-seconds 240 --rotation-seconds 300 --telemetry-seconds 30 --queue-size 10000 --max-reconnect-attempts 8 --reconnect-initial-seconds 1 --reconnect-max-seconds 30 --max-receipt-lag-seconds 10 --checkpoint-every 1000
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/roboweather

[Install]
WantedBy=default.target
